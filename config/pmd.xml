<?xml version="1.0"?>

<ruleset name="TerasologyLauncher PMD ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Custom rules for the Terasology Launcher project.
    </description>

    <!-- Your rules will come here -->

    <rule ref="category/java/errorprone.xml">
        <exclude name="AvoidFieldNameMatchingMethodName"/>
        <exclude name="AvoidFieldNameMatchingTypeName"/>
        <exclude name="AvoidLiteralsInIfCondition"/>
        <!-- BeanMembersShouldSerialize was renamed to NonSerializableClass in PMD 6.52.0. -->
        <exclude name="NonSerializableClass"/>
        <exclude name="DoNotTerminateVM"/>
        <exclude name="MissingSerialVersionUID"/>
        <exclude name="NullAssignment"/>
        <exclude name="SimpleDateFormatNeedsLocale"/>
        <exclude name="UseLocaleWithCaseConversions"/>
        <!-- Flags the SLF4J "trailing Throwable, no matching {} placeholder for it" convention
             (logger.error("msg {}", arg, exception)) as a placeholder/argument-count mismatch -
             that's the documented, correct way to attach a stack trace, not a bug. -->
        <exclude name="InvalidLogMessageFormat"/>
    </rule>

    <rule ref="category/java/codestyle.xml/FieldNamingConventions">
        <properties>
            <!-- PMD 7's "exclusions" is a comma-separated list of names, not a regex - the old
                 pipe-separated value silently stopped matching anything after the 6->7 upgrade. -->
            <property name="exclusions" value="logger,gson,serialVersionUID"/>
        </properties>
    </rule>

</ruleset>